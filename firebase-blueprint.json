        "nama": { "type": "string" },
        "tanggal": { "type": "string" },
        "waktuPresensi": { "type": "string" },
        "jarakMeter": { "type": "number" },
        "fotoSelfie": { "type": "string" }
      }
    },
    "DendaRondaEntry": {
      "title": "DendaRondaEntry",
      "description": "Rekap denda ronda 4 minggu bulan berjalan",
