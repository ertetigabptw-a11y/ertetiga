      "properties": {
        "wargaId": { "type": "number" },
        "nama": { "type": "string" },
        "blok": { "type": "string" },
        "noRumah": { "type": "string" },
        "minggu1": { "type": "boolean" },
        "minggu2": { "type": "boolean" },
        "minggu3": { "type": "boolean" },
        "minggu4": { "type": "boolean" },
        "jumlahAlpa": { "type": "number" },
        "dendaTotal": { "type": "number" },
        "statusPushed": { "type": "boolean" }
