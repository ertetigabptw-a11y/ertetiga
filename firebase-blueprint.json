{
  "entities": {
    "Warga": {
      "title": "Warga",
      "description": "Data warga dan penghuni Perum BPTW RT.03",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "blok": { "type": "string" },
        "noRumah": { "type": "string" },
        "namaPenghuni": { "type": "string" },
        "namaPemilik": { "type": "string" },
        "statusHuni": { "type": "string" },
        "kriteriaRonda": { "type": "string" },
        "totalIuran": { "type": "number" }
      }
    },
    "RondaSchedule": {
      "title": "RondaSchedule",
      "description": "Jadwal dinas ronda malam mingguan",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "hari": { "type": "string" },
        "petugasNames": { "type": "array" }
      }
    },
    "PresensiRonda": {
