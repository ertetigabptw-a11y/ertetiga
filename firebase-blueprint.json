    "SuratRT": {
      "title": "SuratRT",
      "description": "Arsip surat pengantar dan keputusan RT",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nomorSurat": { "type": "string" },
        "perihal": { "type": "string" }
      }
    },
