      "properties": {
        "id": { "type": "string" },
        "tanggal": { "type": "string" },
        "sumber": { "type": "string" },
        "nominal": { "type": "number" }
      }
    },
    "HutangRT": {
      "title": "HutangRT",
      "description": "Kewajiban hutang kas RT kepada pihak ketiga",
