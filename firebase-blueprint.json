  "firestore": {
    "/warga/{wargaId}": {
      "schema": "Warga",
      "description": "Koleksi data kependudukan warga RT.03"
    },
    "/ronda_schedules/{scheduleId}": {
      "schema": "RondaSchedule",
      "description": "Koleksi jadwal regu ronda malam"
    },
    "/presensi_ronda/{presensiId}": {
      "schema": "PresensiRonda",
      "description": "Koleksi log kehadiran ronda malam"
    },
    "/denda_ronda/{dendaId}": {
      "schema": "DendaRondaEntry",
      "description": "Koleksi rekap kehadiran dan denda 4 minggu"
    },
    "/tagihan/{tagihanId}": {
      "schema": "TagihanWarga",
      "description": "Koleksi data tagihan bulanan warga"
    },
    "/pengeluaran/{pengeluaranId}": {
      "schema": "PengeluaranKas",
      "description": "Koleksi pengeluaran buku kas RT"
    },
    "/pemasukan/{pemasukanId}": {
      "schema": "PemasukanKas",
      "description": "Koleksi pemasukan buku kas RT"
    },
    "/hutang/{hutangId}": {
      "schema": "HutangRT",
      "description": "Koleksi catatan hutang RT"
    },
    "/piutang_lainnya/{piutangId}": {
      "schema": "PiutangWargaLainnya",
      "description": "Koleksi catatan piutang non-iuran warga"
    },
    "/kerja_bakti/{eventId}": {
      "schema": "KerjaBaktiEvent",
      "description": "Koleksi agenda kerja bakti"
    },
    "/surat/{suratId}": {
      "schema": "SuratRT",
      "description": "Koleksi surat pengantar dan administrasi RT"
    },
    "/pengumuman/{pengumumanId}": {
      "schema": "Pengumuman",
      "description": "Koleksi pengumuman siaran warga"
    },
    "/keluhan/{keluhanId}": {
      "schema": "KeluhanWarga",
      "description": "Koleksi aspirasi dan keluhan warga"
    },
    "/app_settings/{settingsId}": {
      "schema": "AppSettings",
      "description": "Pengaturan sistem dan koordinat RT"
    },
    "/sync_metadata/{metaId}": {
      "schema": "AppSettings",
      "description": "Metadata status sinkronisasi antarperangkat"
    }
  }
}
