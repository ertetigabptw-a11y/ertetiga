      "title": "TagihanWarga",
      "description": "Data tagihan dan kwitansi iuran warga",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "wargaId": { "type": "number" },
        "nama": { "type": "string" },
        "blokNo": { "type": "string" },
        "periode": { "type": "string" },
        "totalIuran": { "type": "number" },
        "totalKewajiban": { "type": "number" },
        "jumlahDibayar": { "type": "number" },
        "statusBayar": { "type": "string" }
      }
