      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "wargaId": { "type": "number" },
        "judul": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "AppSettings": {
      "title": "AppSettings",
      "description": "Konfigurasi tarif dan koordinat pos ronda",
      "type": "object",
      "properties": {
        "namaRT": { "type": "string" },
        "posRondaLat": { "type": "number" },
        "posRondaLng": { "type": "number" },
        "posRondaRadiusMeters": { "type": "number" }
      }
